# syntax=docker/dockerfile:1
# Limoja patch build: Gitea v28.2.0 with the account Bio (user.description)
# widened to varchar(65535). Build stages mirror Gitea's official
# Dockerfile.rootless; the final stage is the EXACT official rootless image
# with only the patched binary swapped in, so entrypoint/scripts/user/layout
# are byte-identical to what the gitea-12.7.0 helm chart expects.

# Frontend on the native platform (avoids QEMU nodejs issues)
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27-alpine3.24 AS frontend-build
RUN apk --no-cache add build-base git nodejs pnpm
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY . .
RUN make frontend

# Backend for the target platform
FROM docker.io/library/golang:1.27-alpine3.24 AS build-env
ARG TAGS=""
ENV TAGS="bindata timetzdata $TAGS"
RUN apk --no-cache add build-base git
WORKDIR ${GOPATH}/src/gitea.dev
COPY go.mod go.sum ./
RUN go mod download
COPY --exclude=.git/ . .
COPY --from=frontend-build /src/public/assets public/assets
RUN --mount=type=cache,target="/root/.cache/go-build" \
    --mount=type=bind,source=".git/",target=".git/" \
    make backend

# Official rootless runtime image + swapped-in patched binary
FROM docker.gitea.com/gitea:28.2.0-rootless
COPY --from=build-env /go/src/gitea.dev/gitea /app/gitea/gitea
